ARG IMAGE_PREFIX=docker.m.daocloud.io/library/
FROM ${IMAGE_PREFIX}node:22.23.1-bookworm-slim AS console-build
WORKDIR /console
COPY apps/console/package.json apps/console/package-lock.json apps/console/.npmrc ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY apps/console ./
RUN npm run check
FROM ${IMAGE_PREFIX}node:22.23.1-bookworm-slim
WORKDIR /console
COPY --from=console-build /console/dist ./dist
COPY apps/console/server.mjs ./server.mjs
ENV HOST=0.0.0.0 PORT=8081
USER node
EXPOSE 8081
CMD ["node", "server.mjs"]
