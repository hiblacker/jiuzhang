FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /src
COPY apps/control-api/pom.xml apps/control-api/pom.xml
RUN --mount=type=cache,id=bydw-maven,target=/root/.m2,sharing=locked \
    mvn -q -Dmaven.wagon.http.retryHandler.count=5 -f apps/control-api/pom.xml dependency:go-offline
COPY apps/control-api/src apps/control-api/src
RUN --mount=type=cache,id=bydw-maven,target=/root/.m2,sharing=locked \
    mvn -q -Dmaven.wagon.http.retryHandler.count=5 -f apps/control-api/pom.xml package

FROM eclipse-temurin:21.0.12_8-jre-jammy
WORKDIR /app
COPY --from=build /src/apps/control-api/target/control-api-0.1.0-SNAPSHOT.jar /app/control-api.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/control-api.jar"]
