ARG IMAGE_PREFIX=docker.m.daocloud.io/library/
FROM ${IMAGE_PREFIX}mysql:8.0.43 AS mysql
RUN mkdir -p /client/lib && cp /usr/bin/mysql /client/mysql && \
    cp -L /lib64/libncurses.so.6 /client/lib/libncurses.so.6 && \
    cp -L /lib64/libtinfo.so.6 /client/lib/libtinfo.so.6 && \
    rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\t%{LICENSE}\n' > /client/mysql-image-packages.tsv
FROM ${IMAGE_PREFIX}node:22.23.1-bookworm-slim AS node
FROM ${IMAGE_PREFIX}python:3.12.14-slim-trixie
WORKDIR /app
COPY deploy/product-apt-packages.txt /app/deploy/product-apt-packages.txt
RUN printf '%s\n' 'deb https://mirrors.tuna.tsinghua.edu.cn/debian trixie main' > /etc/apt/sources.list && \
    rm -f /etc/apt/sources.list.d/debian.sources && apt-get update -qq && \
    xargs apt-get install -y --no-install-recommends < /app/deploy/product-apt-packages.txt && \
    rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=mysql /client /opt/mysql
COPY --from=mysql /usr/share/licenses /opt/mysql/licenses
RUN printf '%s\n' '#!/bin/sh' 'exec env LD_LIBRARY_PATH=/opt/mysql/lib /opt/mysql/mysql "$@"' > /usr/local/bin/mysql && chmod 755 /usr/local/bin/mysql
COPY deploy/product-requirements.txt /app/deploy/product-requirements.txt
RUN --mount=type=bind,source=deploy/artifacts/linux-wheels,target=/wheels \
    pip install --no-cache-dir --no-index --find-links=/wheels --require-hashes -r /app/deploy/product-requirements.txt && pip check
COPY tools /app/tools
COPY apps/ingestion-worker/lake-runtime.mjs /app/apps/ingestion-worker/lake-runtime.mjs
COPY apps/model-worker /app/apps/model-worker
COPY deploy/artifacts/models.bundle /tmp/models.bundle
RUN git clone --bare /tmp/models.bundle /models.git && rm /tmp/models.bundle && git config --system --add safe.directory /models.git && \
    mkdir -p /app/notices && dpkg-query -W -f='${Package}\t${Version}\n' > /app/notices/debian-packages.tsv && \
    node --version && mysql --version && python --version && dbt --version
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DBT_SEND_ANONYMOUS_USAGE_STATS=false DO_NOT_TRACK=1 LAKE_PYTHON=/usr/local/bin/python
USER 10001:10001
CMD ["node", "/app/apps/ingestion-worker/lake-runtime.mjs", "--registry", "/run/secrets/lake-runtime.json", "--control-api", "http://127.0.0.1:8080", "--instance", "lake-worker"]
