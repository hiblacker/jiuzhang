{
  "version": 1,
  "domain": "devops-source-snapshot",
  "grain": "One row per source VERSION.ID in the pinned snapshot; status and delete flags remain uninterpreted source values",
  "output": "version_snapshot",
  "uniqueKey": ["version_id"],
  "required": [],
  "fields": [
    {"name": "version_id", "type": "text"},
    {"name": "project_id", "type": "text"},
    {"name": "name", "type": "text"},
    {"name": "status_code", "type": "text"},
    {"name": "delete_flag", "type": "text"},
    {"name": "source_created_time", "type": "text"},
    {"name": "source_updated_time", "type": "text"}
  ],
  "inputs": [{
    "alias": "versions",
    "sourceCode": "configured-by-runtime",
    "objectName": "VERSION",
    "columns": [
      {"name": "ID", "type": "text"},
      {"name": "PROJECT_ID", "type": "text"},
      {"name": "NAME", "type": "text"},
      {"name": "STATUS", "type": "text"},
      {"name": "DELETE_FLAG", "type": "text"},
      {"name": "CREATE_TIME", "type": "text"},
      {"name": "UPDATE_TIME", "type": "text"}
    ]
  }],
  "maxInputRows": 1000000,
  "maxOutputRows": 1000000,
  "timeoutSeconds": 300
}
