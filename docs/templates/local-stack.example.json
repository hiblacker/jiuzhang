{
  "version": 1,
  "repository": "/opt/jiuzhang",
  "stateRoot": "/var/lib/jiuzhang/runtime",
  "lakeRoot": "/var/lib/jiuzhang/lake",
  "postgres": {
    "bin": "/opt/postgresql/bin",
    "data": "/var/lib/jiuzhang/postgres",
    "socket": "/var/run/jiuzhang",
    "port": 5432
  },
  "services": {
    "control-api": {
      "command": [
        "/opt/java/bin/java",
        "-jar",
        "/opt/jiuzhang/apps/control-api/target/control-api-0.1.0-SNAPSHOT.jar",
        "--server.address=127.0.0.1"
      ],
      "healthUrl": "http://127.0.0.1:8080/actuator/health",
      "env": {
        "SERVER_PORT": "8080",
        "WAREHOUSE_DB_URL": "jdbc:postgresql://127.0.0.1:5432/warehouse",
        "CONTROL_API_DB_USERNAME": "bydw_control_api_login",
        "CONTROL_API_ALLOWED_ORIGINS": "http://127.0.0.1:8081",
        "LAKE_CALENDAR_DRIVER": "local"
      },
      "envRefs": {
        "CONTROL_API_WORKER_TOKEN": {
          "file": "/run/secrets/runtime-credentials.json",
          "key": "workerToken"
        },
        "CONTROL_API_ADMIN_TOKEN": {
          "file": "/run/secrets/runtime-credentials.json",
          "key": "adminToken"
        },
        "CONTROL_API_DB_PASSWORD": {
          "file": "/run/secrets/runtime-credentials.json",
          "key": "controlPassword"
        }
      }
    },
    "console": {
      "command": [
        "/opt/node/bin/node",
        "/opt/jiuzhang/apps/console/server.mjs"
      ],
      "env": {
        "PORT": "8081",
        "HOST": "127.0.0.1",
        "CONSOLE_API_ORIGIN": "http://127.0.0.1:8080"
      },
      "healthUrl": "http://127.0.0.1:8081"
    },
    "ingestion-worker": {
      "command": [
        "/opt/node/bin/node",
        "/opt/jiuzhang/apps/ingestion-worker/lake-runtime.mjs",
        "--registry",
        "/run/secrets/lake-runtime.json",
        "--control-api",
        "http://127.0.0.1:8080",
        "--instance",
        "lake-worker"
      ],
      "envRefs": {
        "CONTROL_API_WORKER_TOKEN": {
          "file": "/run/secrets/runtime-credentials.json",
          "key": "workerToken"
        }
      }
    },
    "model-worker": {
      "command": [
        "/opt/model-venv/bin/python",
        "/opt/jiuzhang/apps/model-worker/worker.py",
        "--registry",
        "/run/secrets/model-runtime.json",
        "--api",
        "http://127.0.0.1:8080",
        "--instance",
        "model-worker"
      ],
      "envRefs": {
        "CONTROL_API_WORKER_TOKEN": {
          "file": "/run/secrets/runtime-credentials.json",
          "key": "workerToken"
        },
        "MODEL_DATABASE_PASSWORD": {
          "file": "/run/secrets/runtime-credentials.json",
          "key": "modelPassword"
        }
      }
    }
  }
}
