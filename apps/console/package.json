{
  "name": "jiuzhang-console",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/notices.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run build && playwright test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "licenses": "node scripts/dependencies.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:css": "prettier --write \"src/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.css\"",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "lucide-vue-next": "1.0.0",
    "naive-ui": "2.45.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11",
    "vue-eslint-parser": "10.4.1"
  }
}
