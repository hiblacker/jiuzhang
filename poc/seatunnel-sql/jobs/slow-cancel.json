{
  "env": {"job.mode": "batch", "parallelism": 1},
  "source": [{
    "plugin_name": "Jdbc",
    "url": "jdbc:mysql://spike-mysql:3306/spike?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai",
    "driver": "com.mysql.cj.jdbc.Driver",
    "user": "spike_ro",
    "password": "__MYSQL_PASSWORD__",
    "query": "SELECT id, note, SLEEP(0.05) AS slept FROM spike_slow ORDER BY id",
    "fetch_size": 1000
  }],
  "transform": [],
  "sink": [{
    "plugin_name": "LocalFile",
    "path": "/out/slow/rows",
    "file_format_type": "json",
    "options": {"is_enable_transaction": false}
  }]
}
